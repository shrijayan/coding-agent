# Copy this file to .env and fill in your values:
#   cp .env.example .env
#
# The agent fails fast on startup if any of these are missing - there are
# no silent defaults, so a misconfiguration is never invisible.

# Your Anthropic API key. Get one at https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=

# Which Claude model to use. See https://docs.claude.com/en/docs/about-claude/models/overview
AGENT_MODEL=claude-sonnet-5

# Max tokens Claude may generate per response.
AGENT_MAX_TOKENS=4096

# Safety cap: max tool-calling round-trips per user message, so a
# confused model can't loop forever.
AGENT_MAX_ITERATIONS=25

# How long (in seconds) a single bash command may run before it's killed.
AGENT_BASH_TIMEOUT_SECONDS=60
