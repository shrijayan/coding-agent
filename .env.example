# Copy this file to .env and fill in your values:
#   cp .env.example .env
#
# The agent fails fast on startup if any of these are missing - there are
# no silent defaults, so a misconfiguration is never invisible.

# Which AI provider to use:
#   anthropic  - talk to Claude directly
#   openrouter - access hundreds of models (OpenAI, Google, Meta, Claude,
#                and more) through one OpenRouter account
# You only need to fill in the API key for whichever one you pick below -
# the other one can stay blank.
AGENT_PROVIDER=anthropic

# Required if AGENT_PROVIDER=anthropic. Get one at
# https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=

# Required if AGENT_PROVIDER=openrouter. Get one at
# https://openrouter.ai/keys
OPENROUTER_API_KEY=

# Which model to use. The expected format depends on your provider:
#   anthropic:  claude-sonnet-5
#               (see https://docs.claude.com/en/docs/about-claude/models/overview)
#   openrouter: anthropic/claude-sonnet-5  (or openai/gpt-5.1, etc. -
#               browse the full catalog at https://openrouter.ai/models)
AGENT_MODEL=claude-sonnet-5

# Max tokens the model may generate per response.
AGENT_MAX_TOKENS=4096

# Safety cap: max tool-calling round-trips per user message, so a
# confused model can't loop forever.
AGENT_MAX_ITERATIONS=25

# How long (in seconds) a single bash command may run before it's killed.
AGENT_BASH_TIMEOUT_SECONDS=60

# Only used if you run with --enable conversation-summary (see AGENTS.md's
# "How to add a new optimization"). Once conversation history grows past
# this many messages, older ones get compacted into a short summary.
AGENT_SUMMARY_THRESHOLD_MESSAGES=10

# Only used with --enable conversation-summary: this many of the most
# recent messages are always kept verbatim (never summarized), so
# immediate context isn't lost. Must be smaller than the threshold above.
AGENT_SUMMARY_KEEP_RECENT_MESSAGES=4
