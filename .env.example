# Copy this file to .env and fill in your values:
#   cp .env.example .env
#
# WHAT LIVES WHERE:
#   - .env (this file) holds SECRETS (API keys) and per-person behavior
#     knobs. It is the only place secrets ever go - never commit real keys.
#   - src/coding_agent/models.yaml holds WHICH model the agent uses, what
#     each model costs, per-model metadata, the routing ladder, and the
#     session cost cap. That's the shared, checked-in config everyone uses.
#
# The model/provider/cap settings below are OPTIONAL OVERRIDES of the
# models.yaml defaults - leave them blank to use the shared defaults, or
# set one to point your own session at a different model without editing
# the shared file. The agent fails fast on startup if anything required
# (an API key for the selected provider, the numeric knobs below) is
# missing.

# --- Secrets (fill in the one for your provider) ---

# Required if the provider is anthropic. Get one at
# https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=

# Required if the provider is openrouter (the workshop default). Get one at
# https://openrouter.ai/keys
OPENROUTER_API_KEY=

# --- Optional model overrides (default: models.yaml 'default:' block) ---

# Override the provider: anthropic | openrouter | ollama. Blank = models.yaml
# default (openrouter). Set to `ollama` to run entirely on local models with
# NO API key - useful for testing prompt caching and hybrid routing offline
# before you have an OpenRouter key. In ollama mode the base model defaults to
# models.yaml 'provider_models.ollama' and `--enable hybrid-routing` uses the
# 'routing.ollama_tiers' ladder; make sure `ollama serve` is running and the
# models are pulled (e.g. `ollama pull qwen2.5-coder:7b`).
AGENT_PROVIDER=

# Override the base-agent model string. Blank = models.yaml default (or, in
# anthropic/ollama mode, the matching models.yaml 'provider_models' entry).
#   anthropic:  claude-sonnet-5
#   openrouter: deepseek/deepseek-v4-flash-0731   (low: mistralai/mistral-nemo,
#               medium: qwen/qwen3.7-flash, high: deepseek/deepseek-v4-flash-0731)
#   ollama:     ollama/qwen2.5-coder:7b  (a model you've pulled locally)
AGENT_MODEL=

# Override max tokens generated per response. Blank = models.yaml default.
AGENT_MAX_TOKENS=

# Override the per-session spend cap in USD (protects a shared budget).
# A number, or 'none' to disable. Blank = models.yaml session_cost_cap_usd.
AGENT_SESSION_COST_CAP_USD=

# --- Agent behavior (required) ---

# Safety cap: max tool-calling round-trips per user message, so a
# confused model can't loop forever.
AGENT_MAX_ITERATIONS=25

# How long (in seconds) a single bash command may run before it's killed.
AGENT_BASH_TIMEOUT_SECONDS=60

# Only used if you run with --enable conversation-summary (see AGENTS.md's
# "How to add a new optimization"). Once the previous send's real
# input-token count (from the provider's own response) exceeds this many
# tokens, older messages get compacted into a short summary. Purely
# token-based: message count plays no part in the trigger, because cost
# is driven by how big the send is, not how many messages it holds.
# Includes the fixed overhead (system prompt + tool schemas), which is
# ~2-4k tokens, so ~8k means "fold once history pushes a send well past
# that".
AGENT_SUMMARY_TOKEN_THRESHOLD=8000

# Only used with --enable conversation-summary: this many of the most
# recent messages are always kept verbatim (never summarized), so
# immediate context isn't lost. Count-based on purpose - it protects
# cut-point coherence (an in-flight tool call + its result stay whole),
# not size.
AGENT_SUMMARY_KEEP_RECENT_MESSAGES=4

# Only used with --enable loop-guard. Once the same tool call has failed
# with the same error this many times in a row, loop-guard injects a
# corrective nudge before the next real model call.
AGENT_LOOP_GUARD_NUDGE_AFTER=2

# Only used with --enable loop-guard. Once the same tool call has failed
# with the same error this many times in a row, loop-guard skips calling
# the model and halts cleanly instead - the catastrophe cap. Must be
# greater than AGENT_LOOP_GUARD_NUDGE_AFTER above.
AGENT_LOOP_GUARD_HALT_AFTER=4

# Only used with --enable context-window. This many of the most recent
# messages are always kept verbatim; older, bulky tool outputs beyond this
# window become candidates for pruning.
AGENT_CONTEXT_PRUNE_KEEP_RECENT_MESSAGES=6

# Only used with --enable context-window. A tool result's output longer
# than this many characters, once outside the "keep recent" window, gets
# replaced with a short placeholder instead of being resent forever.
AGENT_CONTEXT_PRUNE_MIN_CHARS_TO_PRUNE=400

# Only used with --enable context-window. Registers the on-demand skills
# menu + load_skill tool on top of pruning. Skills add a fixed per-call cost
# (system-prompt menu + tool schema) whether or not one ever loads - set to
# false to measure pruning's savings in isolation from that cost.
AGENT_CONTEXT_WINDOW_SKILLS_ENABLED=true

# Only used with --enable deduplication. A text block (tool result or
# pasted instructions) must be at least this many characters before an
# exact later duplicate of it gets replaced with a short marker - short
# repeats like "ok" are normal conversation, not waste worth marking.
AGENT_DEDUP_MIN_CHARS=200

# --- Hybrid routing overrides (only used with --enable hybrid-routing) ---
# The ladder itself (which models, in what order, with what difficulty
# ceilings) lives in models.yaml under 'routing:' - a data edit, no code
# change. The two settings below default from models.yaml's 'routing:'
# block; override per-person here, or leave blank to use them.

# Where Ollama's OpenAI-compatible endpoint lives (used by any tier whose
# provider is "ollama"). Blank = models.yaml routing.ollama_base_url.
AGENT_ROUTING_OLLAMA_BASE_URL=

# Whether to run the post-generation quality gate on a tier's output.
# true  = check the output and escalate up the ladder on failure.
# false = accept the first tier's output as-is (only move up if it errors).
# Blank = models.yaml routing.quality_gate_enabled.
AGENT_ROUTING_QUALITY_GATE_ENABLED=

# --- Advanced observability (only used with --enable observability-otel) ---
# See AGENTS.md's "Observability" section. The lightweight --enable
# observability tier needs none of this - it's zero-setup, in-memory only.
# Both settings below are the exact values a local Docker stack
# (optimizations/observability_stack.py) or your own free Grafana Cloud
# stack (Connections > OpenTelemetry > Configure) generates for you -
# paste them in verbatim, nothing to construct by hand.

# Where to export real traces/metrics/logs (OTLP/HTTP). Required for
# --enable observability-otel; it fails fast, not silently, if unset.
# Local Docker stack: http://localhost:4318
OTEL_EXPORTER_OTLP_ENDPOINT=

# Only needed for a backend that requires auth (e.g. Grafana Cloud) -
# comma-separated key=value pairs, e.g. "Authorization=Basic%20<token>".
# Blank for the unauthenticated local Docker path.
OTEL_EXPORTER_OTLP_HEADERS=
